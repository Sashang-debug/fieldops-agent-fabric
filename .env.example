# LLM provider: vertex | openai | bedrock | mock
LLM_PROVIDER=mock

# Vertex AI (GCP production)
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_REGION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# OpenAI (optional local dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# RAG
CHROMA_PERSIST_DIR=./data/chroma
KNOWLEDGE_BASE_DIR=./data/knowledge_base

# Observability
OTEL_SERVICE_NAME=fieldops-agent-fabric
OTEL_EXPORT_GCP=true

# API
FIELDOPS_API_HOST=0.0.0.0
FIELDOPS_API_PORT=8080

# MCP tool caller identity (see data/principals.json)
# triage-agent | action-agent | eval-harness
FIELDOPS_PRINCIPAL=triage-agent

# HITL approval TTL for write operations (seconds)
APPROVAL_TTL_SECONDS=3600
